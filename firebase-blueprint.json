{
  "entities": {
    "Agent": {
      "title": "Agent",
      "description": "Verified persona or business .agent directory profile with guardrails and wallet rails.",
      "type": "object",
      "properties": {
        "handle": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[a-z0-9.-]+\\.agent$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "type": { "type": "string", "enum": ["persona", "business"] },
        "verified": { "type": "boolean" },
        "popiaConsentActive": { "type": "boolean" },
        "voiceNumber": { "type": "string", "maxLength": 40 },
        "agentEmail": { "type": "string", "maxLength": 120 },
        "mcpEndpoint": { "type": "string", "maxLength": 240 },
        "skills": { "type": "array" },
        "guardrails": { "type": "object" },
        "walletAddresses": { "type": "object" },
        "geoLocation": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["handle", "ownerUid", "displayName", "type", "verified", "popiaConsentActive", "voiceNumber", "agentEmail", "mcpEndpoint", "skills", "guardrails", "walletAddresses", "createdAt"]
    },
    "Rfp": {
      "title": "Rfp",
      "description": "Reverse-RFP broadcast across directory, DOOH billboards, BLE beacons, and CarPlay.",
      "type": "object",
      "properties": {
        "publisherAgentId": { "type": "string", "maxLength": 128 },
        "publisherOwnerUid": { "type": "string", "maxLength": 128 },
        "publisherHandle": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 3, "maxLength": 160 },
        "description": { "type": "string", "minLength": 5, "maxLength": 2000 },
        "budgetZAR": { "type": "number" },
        "budgetUSD": { "type": "number" },
        "category": { "type": "string", "maxLength": 64 },
        "broadcastChannels": { "type": "array" },
        "status": { "type": "string", "enum": ["OPEN", "NEGOTIATING", "AWARDED", "EXPIRED"] },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["publisherAgentId", "publisherOwnerUid", "publisherHandle", "title", "description", "budgetZAR", "budgetUSD", "category", "broadcastChannels", "status", "expiresAt"]
    },
    "Negotiation": {
      "title": "Negotiation",
      "description": "Bilateral A2A negotiation session between initiator and target agents.",
      "type": "object",
      "properties": {
        "initiatorAgentId": { "type": "string", "maxLength": 128 },
        "initiatorOwnerUid": { "type": "string", "maxLength": 128 },
        "targetAgentId": { "type": "string", "maxLength": 128 },
        "targetOwnerUid": { "type": "string", "maxLength": 128 },
        "surface": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["BARGAINING", "OFFER_ACCEPTED", "REJECTED", "SETTLED"] },
        "stickerPriceZAR": { "type": "number" },
        "currentOfferZAR": { "type": "number" },
        "agreedPriceZAR": { "type": "number" },
        "messages": { "type": "array" },
        "popiaAuditHash": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["initiatorAgentId", "initiatorOwnerUid", "targetAgentId", "targetOwnerUid", "surface", "status", "stickerPriceZAR", "currentOfferZAR", "messages", "popiaAuditHash", "updatedAt"]
    },
    "Settlement": {
      "title": "Settlement",
      "description": "Settled payment ledger entry across PayPal Vault or x402 rails.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "buyerHandle": { "type": "string", "maxLength": 64 },
        "sellerHandle": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "amountZAR": { "type": "number" },
        "amountUSD": { "type": "number" },
        "savedZAR": { "type": "number" },
        "rail": { "type": "string", "enum": ["paypal_vault", "x402_base", "x402_arc", "x402_solana"] },
        "txHash": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["SETTLED"] },
        "settledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sessionId", "buyerHandle", "sellerHandle", "ownerUid", "amountZAR", "amountUSD", "savedZAR", "rail", "txHash", "status", "settledAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Autonomous Google Calendar meeting booking scheduled by agents.",
      "type": "object",
      "properties": {
        "sessionId": { "type": "string", "maxLength": 128 },
        "organizerAgentId": { "type": "string", "maxLength": 128 },
        "attendeeAgentId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 180 },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "meetLink": { "type": "string", "maxLength": 240 },
        "status": { "type": "string", "enum": ["CONFIRMED", "RESCHEDULED", "CANCELLED"] }
      },
      "required": ["organizerAgentId", "attendeeAgentId", "ownerUid", "title", "startTime", "endTime", "meetLink", "status"]
    },
    "AgentEmail": {
      "title": "AgentEmail",
      "description": "Agentic email engage or RFP response processed by Gemini triage.",
      "type": "object",
      "properties": {
        "fromAddress": { "type": "string", "maxLength": 128 },
        "toAddress": { "type": "string", "maxLength": 128 },
        "subject": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 4000 },
        "threadId": { "type": "string", "maxLength": 128 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "aiClassification": { "type": "string", "enum": ["QUALIFIED_ENGAGE", "RFP_RESPONSE", "SPAM_BLOCKED", "MEETING_CONFIRMED"] },
        "autoReplied": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["fromAddress", "toAddress", "subject", "body", "threadId", "ownerUid", "aiClassification", "autoReplied", "timestamp"]
    },
    "VoiceChatSession": {
      "title": "VoiceChatSession",
      "description": "Voice or chat dialer session including 911 civic emergency triage.",
      "type": "object",
      "properties": {
        "callerUid": { "type": "string", "maxLength": 128 },
        "targetHandle": { "type": "string", "maxLength": 64 },
        "dialedNumber": { "type": "string", "maxLength": 40 },
        "channel": { "type": "string", "enum": ["voice", "chat"] },
        "isEmergency": { "type": "boolean" },
        "transcript": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["callerUid", "targetHandle", "dialedNumber", "channel", "isEmergency", "transcript", "createdAt"]
    },
    "Contact": {
      "title": "Contact",
      "description": "Personal contact book entry for shared human or business agent cards.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "handle": { "type": "string", "maxLength": 64 },
        "displayName": { "type": "string", "maxLength": 120 },
        "type": { "type": "string", "enum": ["persona", "business"] },
        "source": { "type": "string", "enum": ["event_wifi", "event_ble", "ble_beacon", "dooh_geofence", "direct_share", "directory"] },
        "favorite": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2000 },
        "sharedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "handle", "displayName", "type", "source", "favorite", "sharedAt"]
    },
    "AgentActionHistory": {
      "title": "AgentActionHistory",
      "description": "Durable timeline of actions performed by human users, HR staff, and personal or company agents.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "string", "maxLength": 128 },
        "agentHandle": { "type": "string", "maxLength": 64 },
        "actorType": { "type": "string", "enum": ["personal_agent", "company_agent", "hr_staff", "user"] },
        "actorName": { "type": "string", "maxLength": 120 },
        "actionType": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "details": { "type": "string", "maxLength": 4000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "agentId", "agentHandle", "actorType", "actorName", "actionType", "title", "details", "timestamp"]
    },
    "UserAgentActivity": {
      "title": "UserAgentActivity",
      "description": "Real-time user and agent activity stream across +Network autopilot, proximity radar, matching, and auth.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "agentHandle": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["auth", "autopilot", "proximity", "match", "negotiation", "recruitment", "comms", "registry", "session", "system"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "detail": { "type": "string", "maxLength": 2000 },
        "valueZAR": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "category", "title", "detail", "timestamp"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Active user and device session binding remembered agents, active workspace tab, and autopilot status.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "authMode": { "type": "string", "enum": ["google", "passkey_sim", "guest"] },
        "userDisplayName": { "type": "string", "maxLength": 120 },
        "agentIds": { "type": "array" },
        "agentHandles": { "type": "array" },
        "status": { "type": "string", "enum": ["active", "idle", "signed_out"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "deviceId", "authMode", "userDisplayName", "agentIds", "agentHandles", "createdAt", "lastActiveAt"]
    },
    "DevicePasskey": {
      "title": "DevicePasskey",
      "description": "WebAuthn or ECDSA P-256 device passkey remembering bound user × agents across sessions.",
      "type": "object",
      "properties": {
        "credentialId": { "type": "string", "maxLength": 256 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "maxLength": 128 },
        "algorithm": { "type": "string", "enum": ["WEBAUTHN_FIDO2", "DEVICE_KEY_P256"] },
        "rememberedAgentIds": { "type": "array" },
        "rememberedAgentHandles": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastUsedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["credentialId", "ownerUid", "deviceId", "algorithm", "rememberedAgentIds", "rememberedAgentHandles", "createdAt", "lastUsedAt"]
    },
    "JobPosting": {
      "title": "JobPosting",
      "description": "Open employer vacancy published by a hiring company agent.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "companyAgentHandle": { "type": "string", "maxLength": 64 },
        "companyName": { "type": "string", "maxLength": 120 },
        "title": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["OPEN", "INTERVIEWING", "FILLED", "PAUSED"] }
      },
      "required": ["companyAgentHandle", "companyName", "title", "status"]
    },
    "StatusPost": {
      "title": "StatusPost",
      "description": "Public status cards announcing verified hires and closed A2A deals.",
      "type": "object",
      "properties": {
        "agentId": { "type": "string", "maxLength": 128 },
        "agentHandle": { "type": "string", "maxLength": 64 },
        "headline": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agentId", "agentHandle", "headline", "body", "createdAt"]
    },
    "X402PaymentReceipt": {
      "title": "X402PaymentReceipt",
      "description": "Cryptographically verified HTTP 402 payment receipt settled by a human or autonomous agent.",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string", "maxLength": 128 },
        "nonce": { "type": "string", "maxLength": 128 },
        "sku": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "enum": ["matches_pack", "ad_boost", "domain_name", "email_inbox", "rfp_boost", "autopilot_pass", "video_audit", "api_pack", "placement_escrow", "wallet_topup"] },
        "title": { "type": "string", "maxLength": 200 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "payerType": { "type": "string", "enum": ["human", "agent"] },
        "payerHandle": { "type": "string", "maxLength": 64 },
        "rail": { "type": "string", "enum": ["paypal_vault", "x402_base", "x402_arc", "x402_solana"] },
        "amountUSD": { "type": "number" },
        "amountZAR": { "type": "number" },
        "txHash": { "type": "string", "maxLength": 160 },
        "x402Token": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "enum": ["SETTLED"] },
        "settledAt": { "type": "string", "format": "date-time" }
      },
      "required": ["paymentId", "nonce", "sku", "category", "title", "ownerUid", "payerType", "payerHandle", "rail", "amountUSD", "amountZAR", "txHash", "x402Token", "status", "settledAt"]
    },
    "AdCampaign": {
      "title": "AdCampaign",
      "description": "Sponsored agent promotion across Status Circles, Directory Featured Slots, and Geo/BLE Radar Beacons.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "agentId": { "type": "string", "maxLength": 128 },
        "agentHandle": { "type": "string", "maxLength": 64 },
        "sponsorName": { "type": "string", "maxLength": 120 },
        "placement": { "type": "string", "enum": ["status_circle", "directory_featured", "radar_beacon"] },
        "headline": { "type": "string", "maxLength": 200 },
        "body": { "type": "string", "maxLength": 2000 },
        "ctaLabel": { "type": "string", "maxLength": 64 },
        "budgetUSD": { "type": "number" },
        "impressions": { "type": "number" },
        "clicks": { "type": "number" },
        "receiptId": { "type": "string", "maxLength": 128 },
        "txHash": { "type": "string", "maxLength": 160 },
        "status": { "type": "string", "enum": ["ACTIVE", "PAUSED", "EXPIRED"] },
        "startsAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "agentHandle", "sponsorName", "placement", "headline", "body", "ctaLabel", "budgetUSD", "impressions", "clicks", "receiptId", "txHash", "status", "startsAt", "expiresAt"]
    },
    "X402AccountEntitlement": {
      "title": "X402AccountEntitlement",
      "description": "Account quota for 10 free matches, bonus credits, AgentMail allowances, and pre-funded x402 wallet guardrails.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "maxLength": 128 },
        "freeMatchesUsed": { "type": "number" },
        "freeMatchLimit": { "type": "number" },
        "bonusMatchCredits": { "type": "number" },
        "walletBalanceUSD": { "type": "number" },
        "autoPayEnabled": { "type": "boolean" },
        "maxAutoPayPerCallUSD": { "type": "number" },
        "totalSpentUSD": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "freeMatchesUsed", "freeMatchLimit", "bonusMatchCredits", "walletBalanceUSD", "autoPayEnabled", "maxAutoPayPerCallUSD", "totalSpentUSD", "updatedAt"]
    }
  },
  "firestore": {
    "/agents/{agentId}": {
      "schema": { "$ref": "#/entities/Agent" },
      "description": "Publicly readable verified .agent profiles; owner-only guardrail and vault updates."
    },
    "/rfps/{rfpId}": {
      "schema": { "$ref": "#/entities/Rfp" },
      "description": "Reverse-RFP listings; OPEN RFPs readable by authenticated users."
    },
    "/negotiations/{sessionId}": {
      "schema": { "$ref": "#/entities/Negotiation" },
      "description": "Bilateral A2A negotiations restricted to initiator or target owner."
    },
    "/settlements/{txId}": {
      "schema": { "$ref": "#/entities/Settlement" },
      "description": "Immutable enterprise audit ledger settlements."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Autonomous Calendar meeting bookings."
    },
    "/agent_emails/{emailId}": {
      "schema": { "$ref": "#/entities/AgentEmail" },
      "description": "Agentic email inbox/outbox threads."
    },
    "/voice_chat_sessions/{callId}": {
      "schema": { "$ref": "#/entities/VoiceChatSession" },
      "description": "Live voice and chat dialer transcripts."
    },
    "/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/Contact" },
      "description": "Per-user personal contacts for shared agent and business cards."
    },
    "/agent_histories/{historyId}": {
      "schema": { "$ref": "#/entities/AgentActionHistory" },
      "description": "Per-user and per-agent audit history entries."
    },
    "/agent_activities/{activityId}": {
      "schema": { "$ref": "#/entities/UserAgentActivity" },
      "description": "Real-time user and autonomous agent activity events."
    },
    "/user_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/UserSession" },
      "description": "Device-bound user session metadata remembering active and created agents."
    },
    "/device_passkeys/{passkeyId}": {
      "schema": { "$ref": "#/entities/DevicePasskey" },
      "description": "Device passkey public-key credentials and bound user × agents memory."
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/JobPosting" },
      "description": "Published employer vacancies for autonomous candidate matching."
    },
    "/status_posts/{postId}": {
      "schema": { "$ref": "#/entities/StatusPost" },
      "description": "Directory status feed posts for hires and closed deals."
    },
    "/x402_receipts/{receiptId}": {
      "schema": { "$ref": "#/entities/X402PaymentReceipt" },
      "description": "Immutable HTTP 402 payment receipts across human and autonomous agent payers."
    },
    "/ad_campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/AdCampaign" },
      "description": "Active and paused sponsored promotion campaigns created via x402."
    },
    "/x402_entitlements/{entitlementId}": {
      "schema": { "$ref": "#/entities/X402AccountEntitlement" },
      "description": "Per-owner quota entitlements (10 free matches, email packs, auto-pay wallet)."
    }
  }
}
